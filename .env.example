# Copy to .env for local development. On Railway, set these in the
# service's Variables tab instead of committing a .env file.

# Discord bot token
DISCORD_TOKEN=

# YouTube Data API v3 key
YOUTUBE_API_KEY=

# Channel ID where deleted messages are logged
LOGGING_CHANNEL=

# Channel ID where new-video announcements are posted
VIDEO_CHANNEL=

# Optional: directory for pickle caches. Set to a mounted volume path
# (e.g. /data) on Railway to persist caches across restarts.
# DATA_DIR=/data
